{
  "expo": {
    "name": "StyleMe",
    "slug": "digitalni-orman",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "digitalniorman",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digitalcloset.digitalniorman",
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikacija koristi kameru da bi mogla da fotografiše tvoje odevne predmete.",
        "NSPhotoLibraryUsageDescription": "Aplikacija pristupa galeriji da bi mogla da izabereš sliku odevnog predmeta.",
        "NSLocationWhenInUseUsageDescription": "Aplikacija koristi tvoju lokaciju da bi prikazala trenutnu vremensku prognozu i predložila odgovarajuću odeću."
      }
    },
    "android": {
      "package": "com.digitalcloset.digitalniorman",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#ffd6e0",
          "dark": {
            "backgroundColor": "#ffd6e0"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikacija pristupa galeriji da bi mogla da izabereš sliku odevnog predmeta.",
          "cameraPermission": "Aplikacija koristi kameru da bi mogla da fotografiše tvoje odevne predmete."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aplikacija koristi tvoju lokaciju da bi prikazala trenutnu vremensku prognozu."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3a2a25"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
